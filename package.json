{
  "name": "english-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace @coach/api run dev",
    "dev:web": "npm --workspace @coach/web run dev",
    "build": "npm --workspace @coach/web run build",
    "seed": "npm --workspace @coach/api run seed",
    "smoke": "node scripts/smoke.mjs",
    "start": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright-core": "^1.65.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
